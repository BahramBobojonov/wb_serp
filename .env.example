WB_CONFIG_FILE=/app/config/search_growth_focus.yaml
WB_CURL_FILE=/data/input/wb_curl.txt
# Optional bootstrap when direct Railway Volume upload is unavailable.
# WB_CURL_B64=<base64 of wb_curl.txt>
WB_DATA_DIR=/data
# Optional manual/smoke override. Omit for automatic six-hour batches.
# WB_RUN_NAME=smoke_20260809
WB_BATCH_TIMEZONE=Asia/Yekaterinburg
WB_BATCH_ANCHOR_HOUR=5
WB_PAGES=2
WB_DEST=-5818883
WB_DEST_LABEL=main
WB_SLEEP_SECONDS=6
WB_QUERY_LIMIT=0
DATABASE_URL=postgresql://user:password@host:port/database
